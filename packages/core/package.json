{
  "name": "@prisma-query/core",
  "version": "0.1.1",
  "description": "The Prisma equivalent of mongoose-paginate-v2 — parse, validate, and transform HTTP query parameters into Prisma-ready objects",
  "repository": {
    "type": "git",
    "url": "https://github.com/basant7/prisma-query.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/basant7/prisma-query#readme",
  "bugs": {
    "url": "https://github.com/basant7/prisma-query/issues"
  },
  "author": "basant7",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ && prettier --check src/",
    "lint:fix": "eslint src/ --fix && prettier --write src/",
    "clean": "rm -rf dist .turbo"
  },
  "keywords": [
    "prisma",
    "query",
    "pagination",
    "filter",
    "sort",
    "search",
    "orm",
    "database",
    "api",
    "rest",
    "query-builder",
    "type-safe"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "peerDependencies": {
    "@prisma/client": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    }
  }
}
