{
  "name": "@prisma-query/fastify",
  "version": "0.1.0",
  "description": "Fastify adapter for @prisma-query/core",
  "repository": {
    "type": "git",
    "url": "https://github.com/basant7/prisma-query.git",
    "directory": "packages/fastify"
  },
  "homepage": "https://github.com/basant7/prisma-query#readme",
  "bugs": {
    "url": "https://github.com/basant7/prisma-query/issues"
  },
  "author": "basant7",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@prisma-query/core": "workspace:*"
  },
  "devDependencies": {
    "fastify": "^4.28.1",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  },
  "peerDependencies": {
    "fastify": ">=4.0.0"
  }
}
