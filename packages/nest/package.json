{
  "name": "@prisma-query/nest",
  "version": "0.1.1",
  "description": "NestJS adapter for @prisma-query/core",
  "repository": {
    "type": "git",
    "url": "https://github.com/basant7/prisma-query.git",
    "directory": "packages/nest"
  },
  "homepage": "https://github.com/basant7/prisma-query#readme",
  "bugs": {
    "url": "https://github.com/basant7/prisma-query/issues"
  },
  "author": "basant7",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@prisma-query/core": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/common": "^10.3.10",
    "@nestjs/core": "^10.3.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0"
  }
}
